# =========================================
# PostgreSQL
# =========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentiment_db
DB_USER=admin
DB_PASSWORD=your_password_here

# =========================================
# Kafka (External - dùng từ máy host)
# =========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Kafka (Internal - dùng trong Docker network)
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9092

# Kafka Topics
KAFKA_TOPIC_INPUT=social_media_stream
KAFKA_TOPIC_PROCESSED=processed_comments
KAFKA_TOPIC_OUTPUT=final_comments
KAFKA_TOPIC_SENTIMENT_INPUT=sentiment-input

# Kafka Consumer Groups
KAFKA_GROUP_FLINK=flink-group
KAFKA_GROUP_DB_WRITER=python-db-writer-group
KAFKA_GROUP_MODEL=roberta-sentiment-group

# =========================================
# Producer
# =========================================
PRODUCER_BATCH_SIZE=10
PRODUCER_SLEEP_TIME=0.5

# =========================================
# API Server
# =========================================
API_HOST=0.0.0.0
API_PORT=8000

# =========================================
# ML Model
# =========================================
MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment
MODEL_VERSION=1.0
MODEL_BATCH_SIZE=16
MODEL_FLUSH_INTERVAL=2
